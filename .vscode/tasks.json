{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MATLAB: Build model framework",
      "type": "shell",
      "command": "matlab",
      "args": ["-batch", "buildModelFramework"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "MATLAB: Run project",
      "type": "shell",
      "command": "matlab",
      "args": ["-batch", "runProject"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "MATLAB: Run tests",
      "type": "shell",
      "command": "matlab",
      "args": ["-batch", "run('tests/run_all_tests.m')"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": []
    }
  ]
}

